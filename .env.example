# Telegram Bot API Token (получить у @BotFather в Telegram)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Google Gemini API Key (получить в Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here

# Модель Gemini (рекомендуется gemini-2.5-flash для минимальной задержки)
GEMINI_MODEL=gemini-2.5-flash

# Telegram Chat ID администратора/владельца для уведомлений о записях (необязательно)
# Узнать свой ID можно через бота @userinfobot
ADMIN_CHAT_ID=

# Имя файла базы данных SQLite
DB_NAME=barbershop.db

# URL веб-приложения Telegram Mini App для администратора (для локального теста или ngrok/сервера)
WEBAPP_URL=http://localhost:8000

# Идентификатор текущего заведения (слаг в таблице tenant_subscription)
TENANT_SLUG=brohouse

# Telegram Chat ID суперадминистратора платформы (для уведомлений, полного bypass и команды /super)
SUPER_ADMIN_CHAT_ID=

# Пароль для доступа к веб-пульту Super-Admin (/super-admin)
SUPER_ADMIN_PASSWORD=superadminbrohouse2026
